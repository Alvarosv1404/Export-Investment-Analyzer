# Copiar a .env y ajustar.

# ── Turso (base de datos SQLite distribuida) ───────────────────────────────
# Crea tu base en https://turso.tech y obtén el token desde el dashboard.
# En Vercel, añade estas variables en Settings → Environment Variables.
TURSO_DATABASE_URL=libsql://<nombre-de-tu-base>-<tu-org>.turso.io
TURSO_AUTH_TOKEN=<tu-token-de-turso>

# ── Desarrollo local (opcional) ────────────────────────────────────────────
# Deja vacío para que el servidor siga leyendo los Excel de data/ en local.
# Solo define las variables de Turso si quieres probar Turso en local.

# Directorio raíz del proyecto (opcional, se autodetecta)
PROJECT_ROOT=
