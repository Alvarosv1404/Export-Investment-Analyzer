# Copiar a .env y ajustar. Ninguna de las fuentes base necesita key.

# Pausa entre llamadas a Comtrade (segundos). La API publica responde 429
# si se insists. Con 1.5s no hubo problemas en las pruebas.
COMTRADE_SLEEP=1.5
COMTRADE_MAX_RETRIES=5

# Opcional: token de la API de suscripcion de UN Comtrade.
# Sin esto se usa el endpoint publico (limite ~500 registros por consulta),
# que es suficiente para analysis por pais a nivel HS-6 de un solo producto.
COMTRADE_SUBSCRIPTION_KEY=

# Directorio raiz del proyecto (opcional, se autodetecta)
PROJECT_ROOT=
