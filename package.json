{
  "name": "export-investment-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de analisis para evaluar inversiones en exportacion (backend FastAPI + frontend Vite)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-api.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:api && npm run test:py",
    "test:py": "python -m pytest",
    "test:api": "node scripts/check-api.mjs",
    "lint": "npm run lint:web && npm run lint:py",
    "lint:py": "python -m ruff check src tests scripts",
    "lint:web": "eslint frontend/js",
    "setup": "node scripts/setup.mjs",
    "tariffs": "python scripts/tariff_helper.py",
    "tariffs:fill": "python scripts/tariff_helper.py --fill",
    "check:ports": "node scripts/check-ports.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "vite": "^6.0.0"
  }
}
